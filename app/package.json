{
  "name": "betterfingers-electron",
  "version": "1.1.0-alpha.1",
  "description": "Private, local-first dictation for Windows and Linux.",
  "author": "Donaven Crenshaw",
  "license": "MIT",
  "homepage": "https://github.com/RoyGSlade/BetterFingers",
  "desktopName": "BetterFingers",
  "main": "out/main/main.js",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "electron-vite build",
    "build:backend": "node scripts/build-backend.js",
    "fix:electron": "node scripts/fix-electron.js",
    "test:unit": "node --test \"tests/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "qa:screens": "node tests/qa/run.mjs",
    "setup:llama:linux": "python3 ../tools/setup_linux_llama_server.py",
    "dist": "npm run build && npm run build:backend && electron-builder --config electron-builder.config.cjs",
    "dist:win": "npm run build && npm run build:backend && electron-builder --config electron-builder.config.cjs --win",
    "dist:linux": "npm run build && npm run build:backend && electron-builder --config electron-builder.config.cjs --linux"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0"
  },
  "build": {
    "appId": "com.betterfingers.desktop",
    "productName": "BetterFingers",
    "copyright": "Copyright © 2026 Donaven Crenshaw",
    "icon": "build/icon.png",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/uiohook-napi/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!.gitkeep"
        ]
      },
      {
        "from": "../assets",
        "to": "assets",
        "filter": [
          "indicator_idle.png",
          "indicator_listening.png",
          "indicator_processing.png",
          "indicator_recording.png"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "BetterFingers",
      "requestedExecutionLevel": "asInvoker"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "executableArgs": [],
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "shortcutName": "BetterFingers",
      "uninstallDisplayName": "BetterFingers ${version}",
      "artifactName": "BetterFingers-Setup-${version}-${arch}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true,
      "license": "../LICENSE",
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  },
  "allowScripts": {
    "electron@43.2.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true
  },
  "dependencies": {
    "uiohook-napi": "^1.5.5"
  }
}
