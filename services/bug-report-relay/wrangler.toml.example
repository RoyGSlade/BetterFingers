name = "betterfingers-bug-report-relay"
main = "src/index.js"
compatibility_date = "2026-08-27"
workers_dev = true

# Create a KV namespace, then replace both placeholder ids:
#   npx wrangler kv namespace create BUG_REPORT_DEDUPE
#   npx wrangler kv namespace create BUG_REPORT_DEDUPE --preview
[[kv_namespaces]]
binding = "BUG_REPORT_DEDUPE"
id = "REPLACE_WITH_PRODUCTION_KV_ID"
preview_id = "REPLACE_WITH_PREVIEW_KV_ID"

# namespace_id is an account-local positive integer chosen by the operator.
# Cloudflare currently permits 10- or 60-second periods. The desktop also
# enforces a one-report-per-minute cooldown, while this edge limit stops abuse
# from modified clients.
[[ratelimits]]
name = "BUG_REPORT_RATE_LIMITER"
namespace_id = "1001"

  [ratelimits.simple]
  limit = 10
  period = 60

# Local wrangler requests lack CF-Connecting-IP. Keep this false/absent in
# deployed environments; set it only in a local .dev.vars file.
[vars]
ALLOW_LOCAL_REQUESTS = "false"
