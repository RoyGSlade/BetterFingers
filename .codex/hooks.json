{
  "description": "Repository-local collab lifecycle hooks for Codex CLI. --client=codex selects Codex's flat systemMessage output. MCP and hooks resolve the same .claude/collab state from the BetterFingers root. Codex has no blockable Stop hook, so a director must keep waiting while children run.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/collab-mcp/hooks.py session_start --client=codex",
            "statusMessage": "Checking collab workspace status",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/collab-mcp/hooks.py user_prompt --client=codex",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/collab-mcp/hooks.py pre_tool --client=codex",
            "statusMessage": "Checking collab file claims (warning only - see AGENTS.md)",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/collab-mcp/hooks.py post_tool --client=codex",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
